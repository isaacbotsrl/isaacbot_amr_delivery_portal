# Copy to .env (untracked) and fill in.

# The pizzeria: datum of the shared ENU frame and the robots' home. The robots' VDA 5050 adapter
# must use the same DATUM and ENU_MAP_ID (isaacbot.datum_lat / datum_lon / enu_map_id).
DATUM_LAT=
DATUM_LON=
ENU_MAP_ID=enu_pizzeria
# Where the robots park, if not exactly the datum:
#SHOP_LAT=
#SHOP_LON=

# HTTP basic auth for the portal (any user name). Empty = no auth (VPN only!).
PORTAL_PASSWORD=

# Robots: the RMF site manager (basic auth password = its SITE_MANAGER_PASSWORD).
SITE_MANAGER_URL=http://10.8.0.1:8020
SITE_MANAGER_PASSWORD=
# Robots the portal may command (until the site manager has a per-robot "delivery" flag).
# Keep them out of RMF: two masters must never send orders to the same robot.
DELIVERY_ROBOTS=
# Or skip the site manager (simulation): FLEET=name:serialNumber[:manufacturer],...
#FLEET=sim_1:SIM001

# VDA 5050 broker (the RMF Mosquitto). The login needs readwrite on uagv/# in the ACL.
MQTT_HOST=10.8.0.1
MQTT_PORT=1883
MQTT_USER=delivery
MQTT_PASSWORD=

# Walking routes: osrm (default: public FOSSGIS foot router, light use only), valhalla,
# google (Routes API, WALK; needs GOOGLE_API_KEY) or straight (simulation).
ROUTING_PROVIDER=osrm
#ROUTING_URL=http://osrm:5000
#GOOGLE_API_KEY=

# Address search (Nominatim). Two-letter country codes narrow it down.
GEOCODE_COUNTRIES=ro
#NOMINATIM_URL=https://nominatim.openstreetmap.org

# Orders
WAYPOINT_SPACING_M=8
MAX_SPEED=0.8
DESTINATION_TOLERANCE_M=3
# true once the robots implement openCargo / confirmPickup / closeCargo
CARGO_ACTIONS=false
# send the robot home as soon as the ticket is delivered
AUTO_RETURN=true
